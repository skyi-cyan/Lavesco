rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function hasAdminClaim() {
      return request.auth != null && 
             request.auth.token.admin == true;
    }
    
    function isParticipant(roundId) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/rounds/$(roundId)/participants/$(request.auth.uid));
    }
    
    function isHost(roundId) {
      return request.auth != null && 
             get(/databases/$(database)/documents/rounds/$(roundId)).data.createdBy == request.auth.uid;
    }
    
    function isFinished(roundId) {
      return get(/databases/$(database)/documents/rounds/$(roundId)).data.status == 'FINISHED';
    }

    function isScoreConfirmed(roundId, uid) {
      return get(/databases/$(database)/documents/rounds/$(roundId)/participants/$(uid))
        .data.get('scoreConfirmedAt', null) != null;
    }

    // 스코어 확정 후 본인이 갱신할 수 있는 참가자 필드 (통계 backfill·닉네임)
    function participantPostConfirmKeys() {
      return [
        'nickname',
        'totalPutts',
        'girHitCount',
        'girTotalCount',
        'firHitCount',
        'firTotalCount',
        'statsVersion',
        'updatedAt'
      ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // 본인 프로필에 쓸 수 있는 필드 (권한 승격 필드 금지)
    function userSelfAllowedKeys() {
      return [
        'uid',
        'email',
        'displayName',
        'nickname',
        'photoURL',
        'provider',
        'handicap',
        'defaultTee',
        'address',
        'dateOfBirth',
        'termsAgreement',
        'createdAt',
        'updatedAt',
        'scoreOnboardingSeenAt',
        'roundCount'
      ];
    }

    function userSelfWriteValid(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && (
          !('uid' in request.resource.data)
          || request.resource.data.uid == request.auth.uid
        )
        && (
          resource == null
            ? request.resource.data.keys().hasOnly(userSelfAllowedKeys())
            : request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(userSelfAllowedKeys())
        );
    }
    
    // 골프장(CC) → 코스 → 홀
    match /golfCourses/{golfCourseId} {
      allow read: if isSignedIn();
      allow write: if hasAdminClaim();
      match /courses/{courseId} {
        allow read: if isSignedIn();
        allow write: if hasAdminClaim();
        match /holes/{holeNo} {
          allow read: if isSignedIn();
          allow write: if hasAdminClaim();
        }
      }
    }
    
    // 레거시 코스 컬렉션
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if hasAdminClaim();
      
      match /teesets/{teeId} {
        allow read: if isSignedIn();
        allow write: if hasAdminClaim();
      }
      
      match /holes/{holeNo} {
        allow read: if isSignedIn();
        allow write: if hasAdminClaim();
      }
    }
    
    // 라운드
    match /rounds/{roundId} {
      // 문서 ID는 예측 불가 → 단건 get 허용 (목록/참여 후 roundIds로 조회)
      allow get: if isSignedIn();
      // 참여 코드 조회 폴백용 (limit 1). 전체 dump 방지.
      allow list: if isSignedIn() && request.query.limit <= 1;
      
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.roundNumber is string
        && request.resource.data.roundNumber.size() == 6;
      
      // 라운드 정보 수정·종료·취소는 Cloud Functions(Admin SDK)에서만.
      // 클라이언트는 참가자(HOST 포함)가 status를 IN_PROGRESS로 바꾸는 것만 허용 (이미 IN_PROGRESS여도 허용:
      // 구버전 앱은 홀 저장 배치에 이 쓰기를 포함하므로 거부되면 스코어 저장 전체가 실패함)
      allow update: if (isParticipant(roundId) || isHost(roundId))
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        && resource.data.status in ['DRAFT', 'IN_PROGRESS']
        && request.resource.data.status == 'IN_PROGRESS';
      
      // 구버전 앱의 클라이언트 취소 호환용 (현재 앱은 cancelRound 함수 사용)
      allow delete: if isHost(roundId) && resource.data.status != 'FINISHED';
      
      match /scores/{uid} {
        allow read: if request.auth.uid == uid
          || isParticipant(roundId)
          || isHost(roundId)
          || hasAdminClaim();
        // 본인 스코어만, 참가 중이고 확정 전이며 라운드가 종료되지 않았을 때
        allow write: if request.auth.uid == uid
          && isParticipant(roundId)
          && !isScoreConfirmed(roundId, uid)
          && !isFinished(roundId);
      }
      
      match /participants/{uid} {
        // 본인 문서 get은 참여 전 alreadyJoined 확인용
        allow read: if request.auth.uid == uid
          || isParticipant(roundId)
          || isHost(roundId)
          || hasAdminClaim();
        // 참여는 본인만, 종료된 라운드에는 참여 불가
        allow create: if request.auth != null
          && request.auth.uid == uid
          && !isFinished(roundId);
        // 본인만 수정. 확정 후에는 통계·닉네임 필드만, role은 변경 불가
        allow update: if request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          && (
            resource.data.get('scoreConfirmedAt', null) == null
            || request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(participantPostConfirmKeys())
          );
        // 나가기·내보내기는 removeParticipant 함수 사용. 구버전 앱의 클라이언트 취소 호환용으로 HOST만 허용
        allow delete: if isHost(roundId) && !isFinished(roundId);
      }
    }
    
    // 라운드 참여 코드 → roundId (추측 가능한 목록 조회 차단)
    match /invites/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.roundId is string
        && request.resource.data.roundId.size() > 0
        && request.resource.data.keys().hasOnly([
          'roundId',
          'createdBy',
          'createdAt',
          'updatedAt'
        ]);
      // 클라이언트는 생성만; 덮어쓰기 방지
      allow update, delete: if hasAdminClaim();
    }
    
    // 코스 추가 요청
    match /courseAddRequests/{requestId} {
      function courseAddRequestUserCreateKeys() {
        return request.resource.data.keys().hasOnly([
          'userId',
          'userEmail',
          'userNickname',
          'golfCourseName',
          'region',
          'details',
          'status',
          'createdAt',
          'updatedAt'
        ]);
      }
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || hasAdminClaim()
      );
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && courseAddRequestUserCreateKeys()
        && request.resource.data.status == 'PENDING'
        && request.resource.data.golfCourseName is string
        && request.resource.data.golfCourseName.size() > 0
        && request.resource.data.golfCourseName.size() <= 200;
      allow update, delete: if hasAdminClaim();
    }
    
    // 사용자 프로필
    match /users/{uid} {
      // 라운드 생성 후 roundCount만 올리는 경우 (status 등 관리 필드는 변경 불가)
      function userRoundCountBumpOnly() {
        return isSignedIn()
          && request.auth.uid == uid
          && resource != null
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['roundCount', 'updatedAt']);
      }

      allow read: if hasAdminClaim() || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if hasAdminClaim()
        || userSelfWriteValid(uid)
        || userRoundCountBumpOnly();
      allow delete: if hasAdminClaim();
      
      match /userStats/{docId} {
        allow read: if hasAdminClaim() || (isSignedIn() && request.auth.uid == uid);
        allow write: if hasAdminClaim() || (isSignedIn() && request.auth.uid == uid);
      }
      match /roundIds/{roundId} {
        allow read: if hasAdminClaim() || (isSignedIn() && request.auth.uid == uid);
        allow write: if hasAdminClaim() || (isSignedIn() && request.auth.uid == uid);
      }
      match /distanceRecords/{recordId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // 메일 발송 큐 (Trigger Email 확장 / Admin SDK 전용 — 클라이언트 접근 금지)
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
